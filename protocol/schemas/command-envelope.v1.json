{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.invalid/protocol/schemas/command-envelope.v1.json",
  "title": "CommandEnvelope",
  "description": "Hub -> device command. Published on MQTT topic device/{device_id}/cmd/{type}.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "ts", "type", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "correlation_id": {
      "description": "Id of the event this command responds to, if any.",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "device_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]{1,6})?Z$"
    },
    "type": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "payload": { "type": "object" }
  }
}
