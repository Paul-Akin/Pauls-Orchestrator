# Copy to .env and fill in what you have. Every provider is optional.
# .env is gitignored. Never commit real keys.

# --- Cloud providers ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Meta Model API (Muse). Meta's docs call this MODEL_API_KEY; either name works.
META_API_KEY=

# --- Local models ---
# Must be a loopback/private address or the `private` route refuses to start.
OLLAMA_API_BASE=http://127.0.0.1:11434

# --- Hub access ---
# Required if server.allow_lan is true (or HUB_HOST is non-loopback, e.g. in Docker).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_API_TOKEN=
# JSON map of device_id -> token. Devices use the token for HTTP webhooks,
# the audio WebSocket, and as their MQTT password.
HUB_DEVICE_TOKENS={}

# --- Memory ---
# Optional override of memory.dir in hub/config/hub.yaml (default ~/hub-memory).
# HUB_MEMORY_DIR=

# --- MQTT (hub's own broker account) ---
HUB_MQTT_USERNAME=hub
HUB_MQTT_PASSWORD=
